# Generate with:  make gen-key   (several allowed, comma-separated, newest first)
MASTER_KEYS=
ADMIN_TOKEN=change-me-admin          # operator: register/delete tenants
INTERNAL_TOKEN=change-me-internal    # adapter -> credential-service
ADAPTER_TOKEN=change-me-adapter      # mcp-server -> adapter
TENANT_RPM=100                       # keep below your Freshdesk plan's per-minute limit
# Output of: python scripts/mint_tenant_token.py <tenant_id>   (comma-separate multiple tenants)
TENANT_TOKENS=
# Public hostname(s) of the MCP server, e.g. mcp.example.com,mcp.example.com:*  (empty = host check off)
ALLOWED_HOSTS=
